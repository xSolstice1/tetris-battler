{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --target wasm32-unknown-unknown",
  "buildCommand": ". \"$HOME/.cargo/env\" && bash scripts/build-web.sh",
  "outputDirectory": "dist/web",
  "headers": [
    {
      "source": "/(.*)\\.(wasm|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
